# ═══════════════════════════════════════════════════════════════════════════════
# EliteMovers — Variables de entorno
# Copia este archivo a .dev.vars (local) o configura en Cloudflare Pages dashboard
# ═══════════════════════════════════════════════════════════════════════════════

# ── Resend ────────────────────────────────────────────────────────────────────
# Solo servidor — obtener en https://resend.com/api-keys
RESEND_API_KEY=

# Email que recibe los formularios de cotización
QUOTE_TO_EMAIL=info@proelitemovers.com

# Sender verificado en Resend (el dominio debe estar verificado)
# Formato: Nombre <email@dominio.com>
QUOTE_FROM_EMAIL=ProElite Movers <quotes@proelitemovers.com>

# ── Cloudflare Turnstile ──────────────────────────────────────────────────────
# Site key (pública — aparece en el frontend)
# Obtener en https://dash.cloudflare.com → Turnstile
PUBLIC_TURNSTILE_SITE_KEY=

# Geoapify Address Autocomplete API key (consumida por /api/cities en el servidor)
# Se conserva el prefijo PUBLIC_ para mantener compatibilidad con la configuracion existente.
PUBLIC_GEOAPIFY_API_KEY=

# Secret key (solo servidor — NUNCA exponer)
TURNSTILE_SECRET_KEY=

# Control de Turnstile — omitir en producción (defaults a true)
# Útil en dev local para saltar la verificación: ENABLE_TURNSTILE=false
ENABLE_TURNSTILE=false
