---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import AboutHero from "../components/sections/AboutHero.astro";
import AboutStory from "../components/sections/AboutStory.astro";
import AboutTrust from "../components/sections/AboutTrust.astro";
import AboutWhereWeWork from "../components/sections/AboutWhereWeWork.astro";
import AboutFinalCta from "../components/sections/AboutFinalCta.astro";
import { aboutUs } from "../data/aboutUs";
import { breadcrumbSchema } from "../lib/schema";
---

<BaseLayout
  title={aboutUs.meta.title}
  description={aboutUs.meta.description}
  schemas={[breadcrumbSchema("About Us", "/about-us/")]}
>
  <Navbar />
  <main id="main-content">
    <AboutHero />
    <AboutStory />
    <AboutTrust />
    <AboutWhereWeWork />
    <AboutFinalCta />
  </main>
  <Footer />
</BaseLayout>
