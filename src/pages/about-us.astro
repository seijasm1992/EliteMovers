---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import AboutHero from "../components/sections/AboutHero.astro";
import AboutStory from "../components/sections/AboutStory.astro";
import AboutTrust from "../components/sections/AboutTrust.astro";
import AboutWhereWeWork from "../components/sections/AboutWhereWeWork.astro";
import AboutFinalCta from "../components/sections/AboutFinalCta.astro";
import { aboutUs } from "../data/aboutUs";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://proelitemovers.com/" },
    { "@type": "ListItem", position: 2, name: "About Us", item: "https://proelitemovers.com/about-us/" },
  ],
};

const breadcrumbSchemaJson = JSON.stringify(breadcrumbSchema).replace(/</g, "\\u003c");
---

<BaseLayout title={aboutUs.meta.title} description={aboutUs.meta.description}>
  <script type="application/ld+json" is:inline set:html={breadcrumbSchemaJson} />
  <Navbar />
  <main id="main-content">
    <AboutHero />
    <AboutStory />
    <AboutTrust />
    <AboutWhereWeWork />
    <AboutFinalCta />
  </main>
  <Footer />
</BaseLayout>
