---
import Footer from "../components/layout/Footer.astro";
import Navbar from "../components/layout/Navbar.astro";
import QuoteForm from "../components/react/QuoteForm";
import Icon from "../components/ui/Icon.astro";
import { quoteForm } from "../data/quoteForm";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const emailHref = `mailto:${site.email}`;
---

<BaseLayout
  title={`Request a Moving Quote | ${site.name}`}
  description="Tell us about your move and receive a clear hourly rate estimate from ProElite Movers."
>
  <Navbar />
  <main id="main-content">
    <section id="top" class="quote-page relative flex min-h-[100svh] items-center overflow-hidden bg-brand-surface px-4 pb-14 pt-28 sm:px-6 sm:pb-20 sm:pt-32 lg:px-8 lg:py-32">
      <div class="quote-page__glow quote-page__glow--gold" aria-hidden="true"></div>
      <div class="quote-page__glow quote-page__glow--green" aria-hidden="true"></div>

      <div class="relative mx-auto w-full max-w-6xl">
        <div class="grid min-w-0 overflow-hidden rounded-[2rem] border border-white/80 bg-offwhite shadow-bubble lg:grid-cols-[0.85fr_1.15fr]">
          <div class="flex min-w-0 flex-col justify-center p-8 sm:p-12 lg:p-16" data-scroll-reveal>
            <p class="eyebrow text-green">Miami Moving Quote</p>
            <h1 class="type-page-title mt-5 max-w-md text-text-strong">
              Tell Us About Your Move
            </h1>
            <p class="mt-6 max-w-md text-base leading-relaxed text-text-subtle sm:text-lg">
              Share the pickup, destination, date, and move size. Our office will review the details and contact you with your hourly rate estimate.
            </p>

            <div class="mt-10 grid gap-5 sm:mt-12">
              <div class="flex min-w-0 items-center gap-4">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-green text-white shadow-soft">
                  <Icon name="email" class="h-5 w-5" />
                </div>
                <div class="min-w-0">
                  <p class="type-label text-text-subtle">Email</p>
                  <div class="mt-1">
                    <a href={emailHref} class="break-all font-accent text-sm font-bold text-text-strong transition-colors hover:text-green">
                      {site.email}
                    </a>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-yellow text-brand-primary shadow-soft">
                  <Icon name="phone" class="h-5 w-5" />
                </div>
                <div>
                  <p class="type-label text-text-subtle">Phone number</p>
                  <div class="mt-1">
                    <a href={site.phoneHref} class="font-accent text-sm font-bold text-text-strong transition-colors hover:text-green">
                      {site.phone}
                    </a>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-ink text-gold shadow-soft">
                  <Icon name="mapPin" class="h-5 w-5" />
                </div>
                <div class="min-w-0">
                  <p class="type-label text-text-subtle">Address</p>
                  <div class="mt-1">
                    <a href={site.addressHref} target="_blank" rel="noopener noreferrer" class="font-accent text-sm font-bold text-text-strong transition-colors hover:text-green">
                      {site.address}
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="flex min-w-0 items-center bg-white/40 p-4 sm:p-8 lg:p-12" data-scroll-reveal style="--reveal-delay: 100ms">
            <div class="mx-auto w-full max-w-[40rem]">
              <QuoteForm client:load variant="page" content={quoteForm} />
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .quote-page::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(115deg, rgb(255 255 255 / 0.72), transparent 48%),
      radial-gradient(circle at 84% 14%, rgb(255 216 77 / 0.15), transparent 27%),
      radial-gradient(circle at 16% 88%, rgb(0 112 76 / 0.08), transparent 25%);
    content: "";
    pointer-events: none;
  }

  .quote-page__glow {
    position: absolute;
    border-radius: 9999px;
    filter: blur(12px);
    opacity: 0.28;
    pointer-events: none;
  }

  .quote-page__glow--gold {
    top: 17%;
    right: -8rem;
    width: 18rem;
    height: 18rem;
    background: var(--color-brand-yellow);
  }

  .quote-page__glow--green {
    bottom: -8rem;
    left: -7rem;
    width: 15rem;
    height: 15rem;
    background: var(--color-green);
  }

  @media (prefers-reduced-motion: reduce) {
    .quote-page__glow {
      filter: none;
    }
  }
</style>
