---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import EliteGuarantee from "../components/sections/EliteGuarantee.astro";
import { licensesPage } from "../data/companyPages";
import { breadcrumbSchema } from "../lib/schema";
---

<BaseLayout
  title={licensesPage.meta.title}
  description={licensesPage.meta.description}
  schemas={[breadcrumbSchema(licensesPage.label, licensesPage.href)]}
>
  <Navbar />
  <!-- pt-20 clears the fixed navbar; on the home this section is not the first one. -->
  <main id="main-content" class="bg-offwhite pt-20">
    <EliteGuarantee headingLevel="h1" showLicenseNote />
  </main>
  <Footer />
</BaseLayout>
