---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Hero from "../components/sections/Hero.astro";
import EliteGuarantee from "../components/sections/EliteGuarantee.astro";
import MoveSteps from "../components/sections/MoveSteps.astro";
import MovingServicesSection from "../components/sections/MovingServicesSection.astro";
import IncludedMoveSection from "../components/sections/IncludedMoveSection.astro";
import QuoteSection from "../components/sections/QuoteSection.astro";
import FAQSection from "../components/sections/FAQSection.astro";
import Footer from "../components/layout/Footer.astro";
---
<BaseLayout>
  <Navbar />
  <main id="main-content">
    <Hero />
    <EliteGuarantee />
    <MoveSteps />
    <MovingServicesSection />
    <IncludedMoveSection />
    <QuoteSection />
    <FAQSection />
  </main>
  <Footer />
</BaseLayout>
