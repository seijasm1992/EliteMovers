---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import { privacyPolicy } from "../data/privacyPolicy";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://proelitemovers.com/" },
    { "@type": "ListItem", position: 2, name: "Privacy Policy", item: "https://proelitemovers.com/privacy-policy/" },
  ],
};

const breadcrumbSchemaJson = JSON.stringify(breadcrumbSchema).replace(/</g, "\\u003c");
---

<BaseLayout title={privacyPolicy.meta.title} description={privacyPolicy.meta.description}>
  <script type="application/ld+json" is:inline set:html={breadcrumbSchemaJson} />
  <Navbar />
  <main id="main-content">
    <section class="bg-brand-surface px-4 pb-16 pt-28 sm:px-6 sm:pb-20 sm:pt-32 lg:px-8 lg:pb-24">
      <div class="mx-auto w-full max-w-3xl">
        <h1 class="type-page-title text-text-strong">{privacyPolicy.title}</h1>
        <p class="mt-4 text-sm text-text-subtle">Last updated: {privacyPolicy.updated}</p>

        <div class="mt-10 grid gap-10">
          {
            privacyPolicy.sections.map((section) => (
              <section>
                <h2 class="type-ui-title font-extrabold text-text-strong">{section.heading}</h2>
                <div class="mt-3 grid gap-3">
                  {section.paragraphs.map((paragraph) => (
                    <p class="text-base leading-relaxed text-text-subtle">{paragraph}</p>
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
