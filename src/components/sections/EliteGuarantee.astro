---
import SectionHeader from "../ui/SectionHeader.astro";
import Card from "../ui/Card.astro";
import Icon from "../ui/Icon.astro";
import { guarantee } from "../../data/guarantee";
---
<section id="guarantee" class="relative bg-offwhite section-rhythm">
  <div class="container-x">
    <div data-scroll-reveal>
      <SectionHeader
        eyebrow={guarantee.eyebrow}
        title={guarantee.title}
        subtitle={guarantee.subtitle}
      />
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        guarantee.cards.map((card, index) => (
          <div
            class="h-full"
            data-scroll-reveal
            style={`--reveal-delay: ${index * 70}ms`}
          >
            <Card class="h-full">
              <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-ink text-gold transition-colors duration-300 group-hover:bg-green group-hover:text-white">
                <Icon name={card.icon} class="h-7 w-7" />
              </div>
              <h3 class="type-card-title mt-6">{card.title}</h3>
              <p class="mt-3 text-base leading-relaxed text-text-subtle">
                {card.description}
              </p>
            </Card>
          </div>
        ))
      }
    </div>
  </div>
</section>
