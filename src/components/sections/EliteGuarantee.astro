---
import SectionHeader from "../ui/SectionHeader.astro";
import Card from "../ui/Card.astro";
import Icon from "../ui/Icon.astro";
import { guarantee } from "../../data/guarantee";
---
<section id="guarantee" class="relative bg-offwhite py-20 sm:py-28">
  <div class="container-x">
    <SectionHeader
      eyebrow={guarantee.eyebrow}
      title={guarantee.title}
      subtitle={guarantee.subtitle}
    />

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        guarantee.cards.map((card) => (
          <Card>
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-ink text-gold transition-colors duration-300 group-hover:bg-green group-hover:text-white">
              <Icon name={card.icon} class="h-7 w-7" />
            </div>
            <h3 class="mt-6 text-xl sm:text-2xl">{card.title}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-text-subtle">
              {card.description}
            </p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
