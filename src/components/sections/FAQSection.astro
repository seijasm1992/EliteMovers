---
import FAQSection from "../react/FAQSection";
import SectionHeader from "../ui/SectionHeader.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import { faqContent } from "../../data/faqContent";

const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqContent.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: {
      "@type": "Answer",
      text: answer,
    },
  })),
};

// Escape opening angle brackets before using set:html in JSON-LD.
const faqPageSchemaJson = JSON.stringify(faqPageSchema).replace(/</g, "\\u003c");
---

<script type="application/ld+json" is:inline set:html={faqPageSchemaJson}></script>

<section id="faq" class="relative min-h-[100svh] bg-white py-20 sm:py-28">
  <div class="container-x">
    <div data-scroll-reveal>
      <SectionHeader eyebrow="FAQs" title="Questions & Answers" />
    </div>

    <div class="mx-auto mt-9 max-w-6xl sm:mt-11">
      <FAQSection client:visible items={faqContent} />
    </div>

    <div class="mx-auto mt-10 max-w-6xl border-t border-ink/10 pt-7 sm:mt-12 sm:pt-8">
      <div class="flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-between sm:gap-8 sm:text-left">
        <p class="font-accent text-sm leading-relaxed text-text-subtle">
          <span class="font-semibold text-text-strong">Need help with your move?</span>
          Call our office or request your hourly rate estimate online.
        </p>

        <Button href="/get-a-quote/" variant="soft" class="group shrink-0">
          Request a Quote
          <Icon
            name="arrowRight"
            class="h-4 w-4 transition-transform duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
          />
        </Button>
      </div>
    </div>
  </div>
</section>
