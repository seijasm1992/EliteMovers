---
import HeroSlider from "../react/HeroSlider.tsx";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import { hero } from "../../data/hero";
---
<section id="top" class="relative flex min-h-[100svh] items-center overflow-hidden">
  <HeroSlider client:load slides={hero.slides} />

  <div class="container-x relative z-10 w-full pt-28 pb-16">
    <div class="max-w-3xl">
      <span class="eyebrow animate-fade-up text-gold" style="animation-delay:0.05s">
        {hero.eyebrow}
      </span>

      <h1
        class="mt-5 animate-fade-up text-balance text-4xl leading-[1.05] text-white sm:text-5xl lg:text-6xl xl:text-7xl"
        style="animation-delay:0.12s"
      >
        {hero.title}
      </h1>

      <p
        class="mt-6 max-w-xl animate-fade-up text-base leading-relaxed text-white/80 sm:text-lg"
        style="animation-delay:0.2s"
      >
        {hero.description}
      </p>

      <div
        class="mt-9 flex animate-fade-up flex-col gap-3 sm:flex-row sm:items-center"
        style="animation-delay:0.28s"
      >
        <Button href={hero.primaryCta.href} variant="gold" size="lg">
          {hero.primaryCta.label}
          <Icon name="arrowRight" class="h-4 w-4" />
        </Button>
        <Button href={hero.secondaryCta.href} variant="outline-light" size="lg">
          <Icon name="phone" class="h-4 w-4" />
          {hero.secondaryCta.label}
        </Button>
      </div>

      <!-- Google rating -->
      <div
        class="mt-10 inline-flex animate-fade-up items-center gap-3 rounded-full border border-white/15 bg-white/10 px-4 py-2.5 backdrop-blur-md"
        style="animation-delay:0.36s"
      >
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.76h3.57c2.08-1.92 3.27-4.74 3.27-8.09Z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.76c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/>
          <path fill="#FBBC05" d="M5.84 14.11a6.6 6.6 0 0 1 0-4.22V7.05H2.18a11 11 0 0 0 0 9.9l3.66-2.84Z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.05l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38Z"/>
        </svg>
        <div class="flex items-center gap-1.5">
          <span class="font-accent text-sm font-semibold text-white">Google</span>
          <span class="font-display text-base text-gold">{hero.rating.score}</span>
          <span class="flex" aria-hidden="true">
            {[0, 1, 2, 3, 4].map(() => <Icon name="star" class="h-3.5 w-3.5 fill-rating text-rating" />)}
          </span>
        </div>
        <span class="hidden text-sm text-white/70 sm:inline">{hero.rating.reviewsLabel}</span>
      </div>
    </div>
  </div>

  <!-- Scroll hint -->
  <div class="absolute bottom-6 left-1/2 z-10 hidden -translate-x-1/2 lg:block">
    <div class="flex h-9 w-5 items-start justify-center rounded-full border border-white/30 p-1.5">
      <span class="h-2 w-0.5 animate-bounce rounded-full bg-white/70"></span>
    </div>
  </div>
</section>
