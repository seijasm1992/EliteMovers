---
import SectionHeader from "../ui/SectionHeader.astro";
import MovingServices from "../react/MovingServices.tsx";
import { movingServicesContent } from "../../data/movingServices";
---
<section id="services" class="relative bg-offwhite py-24 sm:py-32 lg:py-36">
  <div class="container-x">
    <SectionHeader
      eyebrow={movingServicesContent.eyebrow}
      title={movingServicesContent.title}
      subtitle={movingServicesContent.subtitle}
    />

    <div class="mt-14 sm:mt-16 lg:mt-20">
      <MovingServices client:visible services={movingServicesContent.services} />
    </div>
  </div>
</section>
