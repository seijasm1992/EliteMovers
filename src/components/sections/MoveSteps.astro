---
import SectionHeader from "../ui/SectionHeader.astro";
import { steps } from "../../data/steps";
---
<section id="steps" class="relative overflow-hidden bg-text-strong py-20 text-white sm:py-28">
  <!-- subtle decorative grid -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.04]"
    style="background-image:linear-gradient(white 1px,transparent 1px),linear-gradient(90deg,white 1px,transparent 1px);background-size:64px 64px"
    aria-hidden="true"
  >
  </div>

  <div class="container-x relative">
    <SectionHeader
      eyebrow={steps.eyebrow}
      title={steps.title}
      subtitle={steps.subtitle}
      tone="light"
    />

    <ol class="mt-16 grid gap-10 md:grid-cols-3 md:gap-8">
      {
        steps.steps.map((step, i) => (
          <li class="relative">
            {/* connector line (desktop) */}
            {i < steps.steps.length - 1 && (
              <span
                class="absolute left-[4.5rem] top-8 hidden h-px w-[calc(100%-2rem)] bg-gradient-to-r from-gold/60 to-white/10 md:block"
                aria-hidden="true"
              />
            )}
            <div class="flex items-center gap-5 md:flex-col md:items-start">
              <span class="font-display text-6xl leading-none text-gold sm:text-7xl">
                {step.number}
              </span>
            </div>
            <h3 class="mt-5 text-xl text-white sm:text-2xl">{step.title}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-white/65">
              {step.description}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
