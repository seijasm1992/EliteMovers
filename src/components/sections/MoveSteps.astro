---
import { steps } from "../../data/steps";
---
<section id="steps" class="bg-white py-20 sm:py-28 lg:py-32">
  <div class="container-x">
    <div class="grid gap-14 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] lg:gap-x-24 xl:gap-x-32">
      <header class="max-w-md lg:pt-2">
        <span class="eyebrow text-green">{steps.eyebrow}</span>
        <h2 class="mt-5 text-balance text-[clamp(3.25rem,5.4vw,5.5rem)] leading-[0.86] tracking-[-0.03em] text-text-strong">
          {steps.title}
        </h2>
        <p class="mt-7 max-w-sm text-pretty text-base leading-relaxed text-text-subtle sm:text-lg">
          {steps.subtitle}
        </p>
      </header>

      <ol class="border-t border-neutral-soft">
        {
          steps.steps.map((step) => (
            <li class="group relative grid grid-cols-[2.5rem_1fr] gap-x-5 border-b border-neutral-soft py-7 sm:grid-cols-[3rem_1fr] sm:gap-x-6 sm:py-9">
              <span class="flex h-8 w-8 items-center justify-center bg-brand-surface font-accent text-[0.7rem] font-semibold text-text-medium sm:h-9 sm:w-9">
                {step.number}
              </span>
              <div class="pr-7 sm:pr-10">
                <h3 class="text-balance text-[clamp(1.65rem,2.1vw,2.35rem)] leading-[0.95] tracking-[-0.025em] text-text-strong">
                  {step.title}
                </h3>
                <p class="mt-3 max-w-xl text-[0.95rem] leading-relaxed text-text-subtle sm:mt-4">
                  {step.description}
                </p>
              </div>
              <span class="absolute right-0 top-8 h-3 w-3 border-r-2 border-t-2 border-green sm:top-10" aria-hidden="true"></span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
