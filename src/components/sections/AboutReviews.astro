---
import Icon from "../ui/Icon.astro";
import { aboutUs } from "../../data/aboutUs";

const { reviews } = aboutUs;
const stars = Array.from({ length: 5 });
---
<section id="reviews" class="relative bg-offwhite py-16 sm:py-20">
  <div class="container-x">
    <div class="mx-auto flex max-w-md flex-col items-center text-center" data-scroll-reveal>
      <span class="eyebrow text-green">{reviews.eyebrow}</span>
      <h2 class="type-section-title mt-4 text-text-strong">{reviews.title}</h2>

      <div class="mt-6 flex items-center gap-1" aria-hidden="true">
        {stars.map(() => <Icon name="star" class="h-5 w-5 text-rating" />)}
      </div>

      <p class="mt-3 font-accent text-sm font-semibold text-text-subtle">
        <span class="text-text-strong">{reviews.ratingScore} ★</span> ({reviews.reviewCountLabel})
      </p>
    </div>
  </div>
</section>
