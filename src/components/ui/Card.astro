---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---
<div
  class={`group relative rounded-[var(--radius-card)] border border-ink/8 bg-white p-7 shadow-soft transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1.5 hover:shadow-card-hover hover:border-ink/15 ${className}`}
>
  <slot />
</div>
