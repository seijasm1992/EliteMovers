---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---
<div
  class={`group relative rounded-[var(--radius-card)] border-2 border-green/30 bg-white p-7 shadow-soft transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1.5 hover:border-green hover:shadow-card-hover ${className}`}
>
  <slot />
</div>
