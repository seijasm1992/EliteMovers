---
/**
 * Button / link. Variants follow the design-system button styles
 * (Base solid, Outline) for light and dark layouts.
 */
interface Props {
  href?: string;
  variant?: "solid" | "outline" | "gold" | "outline-light" | "soft";
  size?: "md" | "lg";
  class?: string;
  type?: "button" | "submit";
  ariaLabel?: string;
}
const {
  href,
  variant = "solid",
  size = "md",
  class: className = "",
  type = "button",
  ariaLabel,
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 font-accent font-semibold tracking-wide rounded-full transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-[0.98] whitespace-nowrap";

const sizes: Record<string, string> = {
  md: "px-6 py-3 text-sm",
  lg: "px-8 py-4 text-base",
};

const variants: Record<string, string> = {
  solid:
    "bg-ink text-white shadow-soft hover:bg-text-strong hover:-translate-y-0.5 hover:shadow-card-hover focus-visible:outline-ink",
  gold:
    "bg-gold text-ink shadow-soft hover:brightness-105 hover:-translate-y-0.5 hover:shadow-card-hover focus-visible:outline-ink",
  outline:
    "border-2 border-green text-text-strong bg-white/60 hover:border-ink hover:bg-white focus-visible:outline-ink",
  "outline-light":
    "border-2 border-gold text-white hover:bg-white hover:text-ink focus-visible:outline-white",
  soft:
    "bg-green/[0.08] text-green ring-1 ring-inset ring-green/15 hover:bg-green/15 hover:ring-green/25 focus-visible:outline-green",
};

const cls = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
---
{
  href ? (
    <a href={href} class={cls} aria-label={ariaLabel}>
      <slot />
    </a>
  ) : (
    <button type={type} class={cls} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}
