---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "center" | "left";
  tone?: "dark" | "light";
  class?: string;
}
const {
  eyebrow,
  title,
  subtitle,
  align = "center",
  tone = "dark",
  class: className = "",
} = Astro.props;

const alignCls = align === "center" ? "text-center mx-auto items-center" : "text-left items-start";
const titleColor = tone === "light" ? "text-white" : "text-text-strong";
const subColor = tone === "light" ? "text-white/70" : "text-text-subtle";
const eyebrowColor = tone === "light" ? "text-gold" : "text-green";
---
<div class={`flex flex-col gap-4 max-w-2xl ${alignCls} ${className}`}>
  {eyebrow && <span class={`eyebrow ${eyebrowColor}`}>{eyebrow}</span>}
  <h2 class={`text-3xl sm:text-4xl lg:text-5xl leading-[1.08] ${titleColor}`}>
    {title}
  </h2>
  {subtitle && <p class={`text-base sm:text-lg leading-relaxed ${subColor}`}>{subtitle}</p>}
</div>
